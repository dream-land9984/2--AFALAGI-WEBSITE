# ==========================================
# AFALAGI BACKEND CONFIGURATION
# ==========================================

PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# DB_TYPE options: 'mysql' (default for cPanel Database Wizard) or 'postgres'
DB_TYPE=mysql

# If using cPanel Database Wizard (MySQL):
# - DB_HOST is usually 'localhost'
# - DB_PORT is 3306
# - Full database name: cpaneluser_dbname
# - Full username: cpaneluser_dbuser
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=afalagi_db

# If using remote PostgreSQL (e.g. Neon.tech, Supabase):
# DB_TYPE=postgres
# DB_HOST=ep-xyz.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password
# DB_DATABASE=neondb
# DB_SSL=true

# Set to true if connecting to a cloud database requiring SSL
DB_SSL=false

# Automatically creates/syncs tables (users, reports) on startup
DB_SYNCHRONIZE=true

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=afalagi_super_secure_jwt_secret_key_change_me_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed CORS origins (* for all, or comma-separated URLs)
ALLOWED_ORIGINS=*
