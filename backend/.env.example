# ==========================================
# AFALAGI BACKEND CONFIGURATION
# ==========================================

# Server Port (cPanel Passenger sets PORT automatically, but you can specify a fallback)
PORT=3000
NODE_ENV=development

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# In cPanel:
# If PostgreSQL is running on the same server, DB_HOST is usually 'localhost' or '127.0.0.1'
# If using a remote/managed database (e.g. Neon, Supabase, AWS RDS, ElephantSQL), paste the host and enable SSL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=afalagi_db

# Set to true if using remote SSL PostgreSQL (e.g. Neon, Supabase, Render, etc.)
DB_SSL=false

# Automatically synchronize database schema with entities (set true for easy setup)
DB_SYNCHRONIZE=true

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Change this secret key to a strong random string before deploying to production!
JWT_SECRET=afalagi_super_secure_jwt_secret_key_change_me_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed CORS origins (comma-separated list, or * for all)
ALLOWED_ORIGINS=*
